{
    "name": "infrangible/m2-catalog-product-pos",
    "description": "Controls online saleability by a product attribute, e.g. for in-store-only products: hides the add-to-cart button for chosen attribute values and can show a custom button instead.",
    "type": "magento2-module",
    "version": "1.1.3",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "Hyvä",
        "in-store only products",
        "hide add to cart button by attribute",
        "not sold online products"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-catalog-product-pos",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-catalog-product-swatches": "~1.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPOS\\": "src"
        }
    }
}

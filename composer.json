{
    "name": "infrangible/m2-catalog-product-pos",
    "description": "Controls online saleability by a product attribute, e.g. for in-store-only products: hides the add-to-cart button for chosen attribute values and can show a custom button instead.",
    "type": "magento2-module",
    "version": "2.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Catalog",
        "Hyvä",
        "in-store only products",
        "hide add to cart button by attribute",
        "not sold online products"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-pos",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-catalog-product-swatches": "~2.0.0",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-config": "~101.2.0",
        "magento/module-configurable-product": "~100.4.0",
        "magento/module-eav": "~102.1.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductPOS\\": "src"
        }
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    }
}

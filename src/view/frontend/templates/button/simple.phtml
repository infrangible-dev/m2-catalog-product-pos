use Infrangible\CatalogProductPOS\Block\Button;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Button $block */

$buttonText = (string)$block->getButtonText();
$classes = $block->getAttributeCodeClass() . ' ' . $block->getAttributeValueClass();
?>

<?php if (! $block->isSaleable() && $block->isNotSaleable() && $block->showButton()): ?>
    <div class="box-tocart catalog-product-pos-button-box">
        <div class="fieldset">
            <div class="actions">
                <a href="<?= $escaper->escapeUrl((string)$block->getButtonUrl()) ?>"
                   title="<?= $escaper->escapeHtmlAttr($buttonText) ?>"
                   class="action primary tocart catalog-product-pos-button <?= $escaper->escapeHtmlAttr($classes) ?>"
                   id="product-button-pos">
                    <span><?= $escaper->escapeHtml($buttonText) ?></span>
                </a>
                <?= $block->getChildHtml() ?>
            </div>
        </div>
    </div>
<?php endif; ?>

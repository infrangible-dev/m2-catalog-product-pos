use Infrangible\CatalogProductPOS\Block\Attribute;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var Attribute $block */

$attributeValue = $block->getAttributeValue();
$attributeCodeClass = (string)$block->getAttributeCodeClass();
$attributeValueClass = (string)$block->getAttributeValueClass();
?>

<?php if ($block->getAttributeCode() !== null): ?>
    <div class="catalog-product-pos">
        <div class="catalog-product-pos-attribute <?= $escaper->escapeHtmlAttr($attributeCodeClass) ?>">
            <?php if ($attributeValue !== null): ?>
                <span class="catalog-product-pos-attribute-value <?= $escaper->escapeHtmlAttr($attributeValueClass) ?>">
                    <?= $escaper->escapeHtml($attributeValue) ?>
                </span>
            <?php endif; ?>
        </div>
    </div>
<?php endif; ?>
